[confluence]
# Confluence Cloud のURL（例: https://your-domain.atlassian.net）
url = "https://your-domain.atlassian.net"
# Confluenceユーザーのメールアドレス
email = "your-email@example.com"
# Confluence APIトークン（https://id.atlassian.com/manage-profile/security/api-tokens で生成）
api_token = "your-api-token"

[output]
# Markdown出力ディレクトリ（デフォルト: output/markdown）
markdown_dir = "output/markdown"
# 添付ファイル保存ディレクトリ（空の場合はmarkdown_dir内のページディレクトリに配置）
attachments_dir = ""
# 中間ファイル保存ディレクトリ（デフォルト: output/intermediate）
intermediate_dir = "output/intermediate"

[search]
# space コマンドで移行するスペースキーのリスト。指定した順番に処理する
# ユーザースペース（個人用スペース）のキーは「~」で始まる（例: "~5570586eed56ba9b9b4a87ad7418b7086f1063"）
# 空の場合は default_space_key を使う。--space-key を指定したときは、どちらも使わない
space_keys = []
# デフォルトのスペースキー（space_keys が空のときに使う。従来の設定との互換のため残している）
default_space_key = ""

[display]
# 変換時に無視するConfluenceマクロ名のリスト
ignored_macros = []

[drawio]
# draw.io デスクトップ版のコマンドのパス。draw.io の図を SVG にして埋め込むのに使う
# （空の場合は PATH の drawio / draw.io と、既定のインストール先から探す。見つからなければ図は PNG で表示する）
cli_path = ""

# 削除済みユーザーのマッピング（accountId -> 表示名）
# 例:
# [deletedUsers]
# "123456:abcdef" = "山田 太郎"
